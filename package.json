{
  "name": "dredless",
  "version": "0.2.0",
  "description": "A from-scratch simple headless drednot.io client.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./session": "./src/net/session.js",
    "./servers": "./src/net/servers.js",
    "./ships": "./src/game/ships.js",
    "./connection": "./src/game/connection.js",
    "./world": "./src/game/world.js",
    "./protocol/msgpack": "./src/protocol/msgpack.js",
    "./protocol/commands": "./src/protocol/commands.js",
    "./crypto/chacha": "./src/crypto/chacha.js",
    "./compression/lz4": "./src/compression/lz4.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "scripts": {
    "check": "node --check src/index.js && find src -name '*.js' -print0 | xargs -0 -n1 node --check"
  }
}
