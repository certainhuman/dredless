{
    "name": "dredless",
    "version": "0.2.0",
    "description": "A from-scratch simple headless drednot.io client.",
    "type": "module",
    "main": "src/index.js",
    "types": "./src/index.d.ts",
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "browser": "./src/browser.js",
            "node": "./src/node.js",
            "import": "./src/index.js",
            "default": "./src/index.js"
        },
        "./browser": {
            "types": "./src/browser.d.ts",
            "import": "./src/browser.js",
            "default": "./src/browser.js"
        },
        "./node": {
            "types": "./src/node.d.ts",
            "import": "./src/node.js",
            "default": "./src/node.js"
        },
        "./client": {
            "types": "./src/client/index.d.ts",
            "import": "./src/client/index.js",
            "default": "./src/client/index.js"
        },
        "./session": {
            "types": "./src/network/session.d.ts",
            "import": "./src/network/session.js",
            "default": "./src/network/session.js"
        },
        "./servers": {
            "types": "./src/network/servers.d.ts",
            "import": "./src/network/servers.js",
            "default": "./src/network/servers.js"
        },
        "./ships": {
            "types": "./src/network/ships.d.ts",
            "import": "./src/network/ships.js",
            "default": "./src/network/ships.js"
        },
        "./connection": {
            "types": "./src/network/connection.d.ts",
            "import": "./src/network/connection.js",
            "default": "./src/network/connection.js"
        },
        "./world": {
            "types": "./src/state/world/index.d.ts",
            "import": "./src/state/world/index.js",
            "default": "./src/state/world/index.js"
        },
        "./model": {
            "types": "./src/state/model/index.d.ts",
            "import": "./src/state/model/index.js",
            "default": "./src/state/model/index.js"
        },
        "./network": {
            "types": "./src/network/index.d.ts",
            "import": "./src/network/index.js",
            "default": "./src/network/index.js"
        },
        "./state": {
            "types": "./src/state/index.d.ts",
            "import": "./src/state/index.js",
            "default": "./src/state/index.js"
        },
        "./protocol": {
            "types": "./src/protocol/index.d.ts",
            "import": "./src/protocol/index.js",
            "default": "./src/protocol/index.js"
        },
        "./game/generator-maze": {
            "types": "./src/state/generator-maze.d.ts",
            "import": "./src/state/generator-maze.js",
            "default": "./src/state/generator-maze.js"
        },
        "./game/model": {
            "types": "./src/state/model/index.d.ts",
            "import": "./src/state/model/index.js",
            "default": "./src/state/model/index.js"
        },
        "./protocol/msgpack": {
            "types": "./src/protocol/codec/msgpack.d.ts",
            "import": "./src/protocol/codec/msgpack.js",
            "default": "./src/protocol/codec/msgpack.js"
        },
        "./protocol/blueprint": {
            "types": "./src/protocol/outbound/blueprint.d.ts",
            "import": "./src/protocol/outbound/blueprint.js",
            "default": "./src/protocol/outbound/blueprint.js"
        },
        "./protocol/comms": {
            "types": "./src/protocol/outbound/comms.d.ts",
            "import": "./src/protocol/outbound/comms.js",
            "default": "./src/protocol/outbound/comms.js"
        },
        "./protocol/commands": {
            "types": "./src/protocol/outbound/commands.d.ts",
            "import": "./src/protocol/outbound/commands.js",
            "default": "./src/protocol/outbound/commands.js"
        },
        "./protocol/inventory": {
            "types": "./src/protocol/outbound/inventory.d.ts",
            "import": "./src/protocol/outbound/inventory.js",
            "default": "./src/protocol/outbound/inventory.js"
        },
        "./protocol/ship-management": {
            "types": "./src/protocol/outbound/ship-management.d.ts",
            "import": "./src/protocol/outbound/ship-management.js",
            "default": "./src/protocol/outbound/ship-management.js"
        },
        "./protocol/sign": {
            "types": "./src/protocol/outbound/sign.d.ts",
            "import": "./src/protocol/outbound/sign.js",
            "default": "./src/protocol/outbound/sign.js"
        },
        "./protocol/ui-config": {
            "types": "./src/protocol/outbound/ui-config.d.ts",
            "import": "./src/protocol/outbound/ui-config.js",
            "default": "./src/protocol/outbound/ui-config.js"
        },
        "./crypto/chacha": {
            "types": "./src/crypto/chacha.d.ts",
            "import": "./src/crypto/chacha.js",
            "default": "./src/crypto/chacha.js"
        },
        "./compression/lz4": {
            "types": "./src/compression/lz4.d.ts",
            "import": "./src/compression/lz4.js",
            "default": "./src/compression/lz4.js"
        }
    },
    "dependencies": {
        "ws": "^8.18.0"
    },
    "scripts": {
        "check": "node --check src/index.js && find src -name '*.js' -print0 | xargs -0 -n1 node --check",
        "test": "node --test \"test/*.test.js\"",
        "update:item-schema": "node scripts/update-item-schema.js"
    },
    "devDependencies": {
        "dsa-shipshape": "^0.1.2"
    }
}
